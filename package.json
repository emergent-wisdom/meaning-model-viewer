{
  "name": "meaning-model-viewer",
  "version": "0.3.1",
  "description": "Open a Meaning Model run in one view: its processes over the story's years, zoomable from a day to deep time, in layers or together, with the story or its construction played.",
  "keywords": ["meaning-model", "visualization", "world-model", "story", "three.js"],
  "type": "module",
  "bin": {
    "meaning-model-viewer": "serve.mjs"
  },
  "scripts": {
    "start": "node serve.mjs",
    "serve": "node serve.mjs",
    "extract": "node extract.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "serve.mjs",
    "extract.mjs",
    "construction-models.mjs",
    "measures.mjs",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@emergent-wisdom/meaning-model-mcp": "^0.3.0",
    "qrcode": "^1.5.4"
  },
  "author": "Henrik Westerberg",
  "license": "MIT",
  "homepage": "https://github.com/emergent-wisdom/meaning-model-viewer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emergent-wisdom/meaning-model-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/emergent-wisdom/meaning-model-viewer/issues"
  }
}
